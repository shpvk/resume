---
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  <div
    class="absolute inset-0"
    style="
      background-image: radial-gradient(var(--dot) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: radial-gradient(115% 85% at 50% 0%, #000 25%, transparent 72%);
      -webkit-mask-image: radial-gradient(115% 85% at 50% 0%, #000 25%, transparent 72%);
    "
  ></div>

  <div
    data-parallax="120"
    class="absolute -left-[18vw] -top-[32vh] h-[72vh] w-[72vh] rounded-full blur-[100px] will-change-transform"
    style="background: radial-gradient(circle, var(--wash-a), transparent 62%);"
  ></div>

  <div
    data-parallax="200"
    class="absolute -right-[14vw] top-[14vh] h-[56vh] w-[56vh] rounded-full blur-[120px] will-change-transform"
    style="background: radial-gradient(circle, var(--wash-b), transparent 62%);"
  ></div>

  <div
    class="absolute inset-x-0 bottom-0 h-[40vh]"
    style="background: linear-gradient(to top, var(--color-canvas) 20%, transparent);"
  ></div>
</div>
