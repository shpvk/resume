---
import { getProfile } from '~/data/profile';
import { getLocaleFromUrl, useTranslations } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const profile = getProfile(locale);
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal data-reveal-stagger="70">
  {profile.skills.map((group) => (
    <article class="card card-glow p-4 sm:p-6">
      <header class="mb-4 flex items-center gap-3">
        <span class="counter scale-90">{group.index}</span>
        <h3 class="display text-base text-ink">{group.title}</h3>
      </header>

      <ul class="space-y-2.5">
        {group.items.map((item) => (
          <li class="flex gap-2.5 text-sm leading-snug text-muted">
            <span
              aria-hidden="true"
              class="mt-[0.5rem] h-1.5 w-1.5 shrink-0 rounded-full bg-line-strong"
            />
            {item}
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>

{profile.learning.length > 0 && (
  <div
    class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-line/60 pt-8"
    data-reveal
  >
    <span class="eyebrow">{t('skills.learning')}</span>
    <ul class="flex flex-wrap gap-2">
      {profile.learning.map((item) => (
        <li class="chip chip-outline">{item}</li>
      ))}
    </ul>
  </div>
)}
