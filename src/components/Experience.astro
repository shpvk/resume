---
import type { TimelineEntry } from '~/data/profile';
import { getProfile } from '~/data/profile';
import { getLocaleFromUrl, useTranslations } from '~/i18n/utils';
import Icon from '~/components/Icon.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const profile = getProfile(locale);

const groups: { label: string | null; entries: TimelineEntry[] }[] = [
  { label: null, entries: profile.experience },
  { label: t('experience.education'), entries: profile.education },
];
---

<div class="space-y-14">
  {groups
    .filter((group) => group.entries.length > 0)
    .map((group) => (
      <div>
        {group.label && (
          <h3 class="eyebrow mb-6" data-reveal>
            {group.label}
          </h3>
        )}

        <ol class="relative space-y-4" data-reveal data-reveal-stagger="110">
          {group.entries.map((entry) => (
            <li class="card group relative p-4 sm:p-7">
              <span
                aria-hidden="true"
                class="absolute left-0 top-6 h-8 w-px origin-top scale-y-0 bg-accent transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100"
              />

              <div class="flex flex-col gap-2 lg:flex-row lg:items-baseline lg:justify-between lg:gap-6">
                <h4 class="display min-w-0 text-base leading-relaxed text-ink sm:text-lg">
                  {entry.title}
                  <span class="text-faint"> @ </span>
                  {(() => {
                    if (entry.url) {
                      return (
                        <a
                          href={entry.url}
                          target="_blank"
                          rel="noreferrer noopener"
                          class="link-wipe font-normal text-muted transition-colors hover:text-accent"
                        >
                          {entry.org}
                        </a>
                      );
                    } else {
                      return <span class="font-normal text-muted">{entry.org}</span>;
                    }
                  })()}
                </h4>
                <span class="shrink-0 font-mono text-xs text-faint tabular-nums">
                  {entry.period}
                  {entry.location && <span class="ml-2 hidden sm:inline">· {entry.location}</span>}
                </span>
              </div>

              <ul class="mt-4 space-y-2">
                {entry.bullets.map((bullet) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted">
                    <span
                      aria-hidden="true"
                      class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent/50"
                    />
                    {bullet}
                  </li>
                ))}
              </ul>

              {entry.stack && entry.stack.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {entry.stack.map((tech) => (
                    <li class="rounded-lg bg-subtle px-2 py-1 font-mono text-[0.7rem] text-muted">
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}

  {profile.certificates.length > 0 && (
    <div>
      <h3 class="eyebrow mb-6" data-reveal>
        {t('experience.certificates')}
      </h3>

      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-reveal data-reveal-stagger="90">
        {profile.certificates.map((cert) => (
          <li>
            <a
              href={cert.file}
              target="_blank"
              rel="noreferrer noopener"
              class="card card-glow group flex items-center gap-4 p-5"
            >
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name="certificate" class="h-5 w-5" />
              </span>

              <span class="min-w-0 flex-1">
                <span class="block font-medium text-ink">{cert.name}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-faint">
                  {cert.issuer} · {cert.date}
                </span>
              </span>

              <Icon
                name="arrow-up-right"
                class="h-4 w-4 shrink-0 text-faint transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
